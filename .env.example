# Configurações de ambiente

# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT
JWT_SECRET=finzee-secret-key-change-in-production

# Server
PORT=3000
NODE_ENV=development

# Resend API para envio de e-mails
# 1. Crie uma conta em: https://resend.com/signup
# 2. Gere uma API Key em: https://resend.com/api-keys
# 3. Cole a API Key abaixo (formato: re_xxxxxxxxxxxxx)
RESEND_API_KEY="re_sua_api_key_aqui"
# Email remetente (use seu domínio verificado no Resend)
RESEND_FROM_EMAIL="Finzee <noreply@seudominio.com.br>"

# Frontend URL (para links nos e-mails)
FRONTEND_URL="http://localhost:4200"

# ===== DESCONTINUADO: Gmail SMTP =====
# As variáveis abaixo NÃO SÃO MAIS USADAS (migrado para Resend API)
# GMAIL_USER="seu-email@gmail.com"
# GMAIL_APP_PASSWORD="sua-senha-de-app-do-gmail"

# Supabase (para uso futuro)
# SUPABASE_URL=your-supabase-url
# SUPABASE_KEY=your-supabase-key
