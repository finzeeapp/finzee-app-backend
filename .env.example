# Configurações de ambiente

# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT
JWT_SECRET=finzee-secret-key-change-in-production

# Server
PORT=3000
NODE_ENV=development

# Gmail SMTP para envio de notificações por e-mail
# Siga os passos para gerar uma senha de app:
# 1. Acesse: https://myaccount.google.com/security
# 2. Ative a verificação em 2 etapas
# 3. Vá em "Senhas de app" e gere uma senha para "Email"
# 4. Use a senha gerada abaixo (16 caracteres sem espaços)
GMAIL_USER="seu-email@gmail.com"
GMAIL_APP_PASSWORD="sua-senha-de-app-do-gmail"

# Frontend URL (para links nos e-mails)
FRONTEND_URL="http://localhost:4200"

# Supabase (para uso futuro)
# SUPABASE_URL=your-supabase-url
# SUPABASE_KEY=your-supabase-key
